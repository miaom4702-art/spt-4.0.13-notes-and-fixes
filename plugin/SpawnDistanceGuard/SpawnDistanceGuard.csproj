<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>SpawnDistanceGuard</AssemblyName>
    <RootNamespace>SpawnDistanceGuard</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Version>1.0.0</Version>
    <Nullable>disable</Nullable>
    <DebugType>none</DebugType>
    <NoWarn>CS0168;CS0219;NU1701</NoWarn>

    <!-- 你的 SPT 根目录。命令行覆盖： dotnet build -c Release -p:SptRoot="C:\Games\SPT" -->
    <SptRoot Condition="'$(SptRoot)' == ''">D:\ETF\SPT-4.0.13</SptRoot>
    <ManagedDir>$(SptRoot)\EscapeFromTarkov_Data\Managed</ManagedDir>
    <BepInExCore>$(SptRoot)\BepInEx\core</BepInExCore>
  </PropertyGroup>

  <ItemGroup>
    <!-- net472 参考程序集：没有装 Visual Studio 也能编译 -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(ManagedDir)\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(ManagedDir)\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(ManagedDir)\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Comfort">
      <HintPath>$(ManagedDir)\Comfort.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="BepInEx">
      <HintPath>$(BepInExCore)\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BepInExCore)\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
